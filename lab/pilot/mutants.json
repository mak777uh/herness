   "replace": "        } else {\n            let _ = line;\n        }"
  },
  {
   "id": "c16-line-count-offbyone",
   "class": "critical",
   "why": "выдать line_count+1 строк",
   "find": "            if lines.len() >= request.line_count {\n                stop_reason = StopReason::LineCap;\n                break 'outer;\n            }",
   "replace": "            if lines.len() > request.line_count {\n                stop_reason = StopReason::LineCap;\n                break 'outer;\n            }"
  },
  {
   "id": "f01-bytecap-as-linecap",
   "class": "functional",
   "why": "byte_cap назван line_cap",
   "find": "            stop_reason = StopReason::ByteCap;\n            break;\n        }\n    }\n",
   "replace": "            stop_reason = StopReason::LineCap;\n            break;\n        }\n    }\n"
  },
  {
   "id": "f02-linecap-as-bytecap",
   "class": "functional",
   "why": "line_cap назван byte_cap",
   "find": "                stop_reason = StopReason::LineCap;\n                break 'outer;",
   "replace": "                stop_reason = StopReason::ByteCap;\n                break 'outer;"
  },
  {
   "id": "f03-outputcap-as-bytecap",
   "class": "functional",
   "why": "output_cap назван byte_cap",
   "find": "                stop_reason = StopReason::OutputCap;\n                break 'outer;",
   "replace": "                stop_reason = StopReason::ByteCap;\n                break 'outer;"
  },
  {
   "id": "f04-empty-one-line",
   "class": "functional",
   "why": "пустой файл даёт пустую строку",
   "find": "let truncated = stop_reason != StopReason::Eof;",
   "replace": "if eof && pending.is_empty() && lines.is_empty() {\n        lines.push(String::new());\n    }\n    let truncated = stop_reason != StopReason::Eof;"
  },
  {
   "id": "f05-received-offbyone",
   "class": "functional",
   "why": "bytes_received теряет байт",
   "find": "bytes_received += take;",
   "replace": "bytes_received += take.saturating_sub(1);"
  },
  {
   "id": "f06-max-lines-201",
   "class": "functional",
   "why": "схема принимает line_count=201",
   "find": "pub const MAX_LINES: usize = 200;",
   "replace": "pub const MAX_LINES: usize = 201;"
  },
  {
   "id": "f07-min-max-bytes-0",
   "class": "functional",
   "why": "схема принимает max_bytes_read=0",
   "find": "pub const MIN_MAX_BYTES: usize = 1;",
   "replace": "pub const MIN_MAX_BYTES: usize = 0;"
  },
  {
   "id": "f08-truncated-output-only",
   "class": "functional",
   "why": "truncated=true только на output_cap",
   "find": "let truncated = stop_reason != StopReason::Eof;",
   "replace": "let truncated = matches!(stop_reason, StopReason::OutputCap);"
  }
 ]
}
