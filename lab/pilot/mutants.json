   "replace": ""
  },
  {
   "id": "c04-k4-too-broad",
   "class": "critical",
   "why": "ложный K4 при уже выданных строках",
   "find": "if lines.is_empty() && !pending.is_empty() {",
   "replace": "if !pending.is_empty() {"
  },
  {
   "id": "c05-emit-partial",
   "class": "critical",
   "why": "выдать неполную строку на byte_cap",
   "find": "            stop_reason = StopReason::ByteCap;\n            break;\n        }\n    }\n",
   "replace": "            if !pending.is_empty() {\n                let line = std::mem::take(&mut pending);\n                emit_line(&line, &mut lines, &mut bytes_read)?;\n            }\n            stop_reason = StopReason::ByteCap;\n            break;\n        }\n    }\n"
  },
  {
   "id": "c06-output-cap-ge",
   "class": "critical",
   "why": "считать строку ровно 8192 байт переполнением",
   "find": ".is_none_or(|total| total > OUTPUT_BYTES)",
   "replace": ".is_none_or(|total| total >= OUTPUT_BYTES)"
  },
  {
   "id": "c07-no-output-cap",
   "class": "critical",
   "why": "не останавливаться на output cap",
   "find": ".is_none_or(|total| total > OUTPUT_BYTES)",
   "replace": ".is_none_or(|_total| false)"
  },
  {
   "id": "c08-strip-cr",
   "class": "critical",
   "why": "срезать CR из выданной строки",
   "find": "let content = line_bytes.strip_suffix(b\"\\n\").unwrap_or(line_bytes);",
   "replace": "let content = line_bytes.strip_suffix(b\"\\r\\n\").or_else(|| line_bytes.strip_suffix(b\"\\n\")).unwrap_or(line_bytes);"
  },
  {
   "id": "c09-split-on-cr",
   "class": "critical",
   "why": "делить строки по CR, а не только по LF",
   "find": "while let Some(position) = pending.iter().position(|byte| *byte == b'\\n') {",
   "replace": "while let Some(position) = pending.iter().position(|byte| *byte == b'\\n' || *byte == b'\\r') {"
  },
  {
   "id": "c10-utf8-lossy",
   "class": "critical",
   "why": "не отказывать S12 на невалидном UTF-8",
   "find": "    let text = std::str::from_utf8(content)\n        .map_err(|error| encoding_error(format!(\"выданная строка не UTF-8: {error}\")))?;\n",
   "replace": "    let text = String::from_utf8_lossy(content).into_owned();\n    let text = text.as_str();\n"
  },
  {
   "id": "c11-truncated-false",
   "class": "critical",
   "why": "всегда truncated=false",
   "find": "let truncated = stop_reason != StopReason::Eof;",
   "replace": "let truncated = false;"
  },
  {
   "id": "c12-truncated-true",
   "class": "critical",
   "why": "всегда truncated=true",
   "find": "let truncated = stop_reason != StopReason::Eof;",
   "replace": "let truncated = true;"
  },
  {
   "id": "c13-bytes-read-received",
   "class": "critical",
   "why": "bytes_read выдаёт bytes_received",
   "find": "        lines,\n        bytes_read,\n        bytes_received,",
   "replace": "        lines,\n        bytes_read: bytes_received,\n        bytes_received,"
  },
  {
   "id": "c14-bytes-read-no-lf",
   "class": "critical",
   "why": "bytes_read не считает LF",
   "find": "*bytes_read += line_bytes.len();",
   "replace": "*bytes_read += line_bytes.len().saturating_sub(1);"
  },
  {
   "id": "c15-drop-final-line",
   "class": "critical",
   "why": "терять последнюю строку без LF",
