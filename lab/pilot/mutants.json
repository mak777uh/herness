{
 "schema": "herness-mutant-set-v1",
 "target": "file_read_stream",
 "mutants": [
  {
   "id": "c01-ignore-max-read",
   "class": "critical",
   "why": "читать больше max_bytes_read",
   "find": "let want = CHUNK.min(request.max_bytes_read - bytes_received);",
   "replace": "let want = CHUNK;"
  },
  {
   "id": "c02-ignore-line-count",
   "class": "critical",
   "why": "выдать больше line_count строк",
   "find": "            if lines.len() >= request.line_count {\n                stop_reason = StopReason::LineCap;\n                break 'outer;\n            }\n",
   "replace": ""
  },
  {
   "id": "c03-no-k4",
   "class": "critical",
   "why": "не отказывать K4, когда cap меньше первой строки",
