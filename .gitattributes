# нормализация переводов строк
* text=auto

*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
# JSONL реестра: genesis-событие связывает точные байты registry.jsonl; CRLF на checkout
# сломал бы snapshot_digest и prev цепочки
*.jsonl text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# кандидаты генератора: source.rs/tests.rs сравниваются с выводом генератора байт-в-байт,
# CRLF на checkout сломал бы --check и generation_digest
lab/candidates/** text eol=lf
# свидетельства, digest которых зафиксирован в пре-регистрациях (LF-байты до прогона)
research/outputs/HEAD-SLICE-R1-2026-11-17.txt text eol=lf
research/outputs/PILOT-GENERATOR-R1-2026-11-17.txt text eol=lf

# Digest конституции запечатан в provenance карточки head и 20 карточек кандидатов
# как sha256:e9d6f904… — он был измерен на CRLF checkout. Пиннинг делает эти байты
# воспроизводимыми на любой ОС; с LF на чистом клоне гейт provenance падает.
# Это не меняет текст конституции, а фиксирует представление, для которого
# считались digest'ы. При смене представления нужно перепечатать карточки.
docs/CONSTITUTION-v0-2026-11-16.md text eol=crlf

# SHA-256 HEAD-SLICE-R1 prereg заморожен в PILOT-GENERATOR-R1 до прогона также
# по CRLF-байтам (sha256:4522784c…). Пиннинг сохраняет --verify на чистом клоне.
lab/prereg/HEAD-SLICE-R1.json text eol=crlf

# Карточка head запечатана в HEAD-SLICE-R1 по CRLF-байтам (sha256:361ad2ec…):
# promoter и репетиция сверяют её точные байты с digest карточки. Общий *.json
# даёт LF, поэтому представление фиксируется отдельно; при смене — перепечатать.
lab/tools/drafts/head-v1.draft.json text eol=crlf

# бинарь
*.zstd binary
*.png binary
*.jpg binary
*.zip binary

# тела свидетельств — байт-в-байт, без нормализации переводов строк
evidence/objects/** -text
evidence/index.jsonl text eol=lf
# фикстура среза: sha256 в manifest/пре-регистрации считается по байтам,
# нормализация LF на checkout сломает сверку
lab/fixtures/model_visible/head-slice.txt -text -eol
# ключ ответа CONTINUITY-R1: raw-байты запечатаны в prereg ДО прогона (sha256 326019c1…),
# коммитится байт-в-байт (CRLF как запечатано), иначе нормализация LF сломает сверку хеша
research/outputs/continuity-key-R1.json -text
# ключ ответа CONTINUITY-R2: raw-байты (LF) запечатаны в prereg ДО прогона (sha256 e5495bf7…),
# коммитится байт-в-байт, иначе нормализация сломает сверку хеша
research/outputs/continuity-key-R2.json -text
# сырые ответы внешних моделей: sha256 в README считается по байтам файла,
# нормализация LF сломает сверку (ответ A пришёл с CRLF)
docs/research/external/2026-11-16-R5-answer-*.md -text -eol
# то же для R6: шесть сырых ответов (A-E .txt, F .md) коммитятся байт-в-байт,
# иначе sha256 в README перестанет совпадать с файлом
docs/research/external/2026-11-17-R6-answer-* -text -eol
# то же для R7: пять сырых ответов (A-C, E .txt; D .md) коммитятся байт-в-байт,
# иначе sha256 в README перестанет совпадать с файлом
docs/research/external/2026-11-17-R7-answer-* -text -eol
# то же для R8: пять сырых ответов (A-C, E .txt; D .md) коммитятся байт-в-байт,
# иначе sha256 в README перестанет совпадать с файлом
docs/research/external/2026-11-17-R8-answer-* -text -eol
# то же для R9: первый ответ A коммитится байт-в-байт,
docs/research/external/2026-11-23-R9-answer-* -text -eol
# то же для R9.1: ответ A (дожим) — байт-в-байт,
docs/research/external/2026-11-23-R9.1-answer-* -text -eol
