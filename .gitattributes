# нормализация переводов строк
* text=auto

*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# бинарь
*.zstd binary
*.png binary
*.jpg binary
*.zip binary

# тела свидетельств — байт-в-байт, без нормализации переводов строк
evidence/objects/** -text
evidence/index.jsonl text eol=lf
# фикстура среза: sha256 в manifest/пре-регистрации считается по байтам,
# нормализация LF на checkout сломает сверку
lab/fixtures/model_visible/head-slice.txt -text -eol
# ключ ответа CONTINUITY-R1: raw-байты запечатаны в prereg ДО прогона (sha256 326019c1…),
# коммитится байт-в-байт (CRLF как запечатано), иначе нормализация LF сломает сверку хеша
research/outputs/continuity-key-R1.json -text
# ключ ответа CONTINUITY-R2: raw-байты (LF) запечатаны в prereg ДО прогона (sha256 e5495bf7…),
# коммитится байт-в-байт, иначе нормализация сломает сверку хеша
research/outputs/continuity-key-R2.json -text
# сырые ответы внешних моделей: sha256 в README считается по байтам файла,
# нормализация LF сломает сверку (ответ A пришёл с CRLF)
docs/research/external/2026-11-16-R5-answer-*.md -text -eol
# то же для R6: шесть сырых ответов (A-E .txt, F .md) коммитятся байт-в-байт,
# иначе sha256 в README перестанет совпадать с файлом
docs/research/external/2026-11-17-R6-answer-* -text -eol
# то же для R7: пять сырых ответов (A-C, E .txt; D .md) коммитятся байт-в-байт,
# иначе sha256 в README перестанет совпадать с файлом
docs/research/external/2026-11-17-R7-answer-* -text -eol
