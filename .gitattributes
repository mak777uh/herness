# нормализация переводов строк
* text=auto

*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# бинарь
*.zstd binary
*.png binary
*.jpg binary
*.zip binary

# тела свидетельств — байт-в-байт, без нормализации переводов строк
evidence/objects/** -text
evidence/index.jsonl text eol=lf
