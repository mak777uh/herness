# нормализация переводов строк
* text=auto

*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# бинарь
*.zstd binary
*.png binary
*.jpg binary
*.zip binary

# тела свидетельств — байт-в-байт, без нормализации переводов строк
evidence/objects/** -text
evidence/index.jsonl text eol=lf
# ключ ответа CONTINUITY-R1: raw-байты запечатаны в prereg ДО прогона (sha256 326019c1…),
# коммитится байт-в-байт (CRLF как запечатано), иначе нормализация LF сломает сверку хеша
research/outputs/continuity-key-R1.json -text
